# LinkedIn Search MCP Server — copy this to .env and fill in your values

# OPTION 1 (recommended): li_at cookie from your browser
# How to get it:
#   1. Log into linkedin.com in Chrome
#   2. F12 → Application → Cookies → https://www.linkedin.com
#   3. Copy the value of the "li_at" cookie
LINKEDIN_COOKIE=your_li_at_cookie_value_here

# OPTION 2: username + password (only works on non-datacenter / residential IPs)
# LINKEDIN_EMAIL=you@example.com
# LINKEDIN_PASSWORD=yourpassword
