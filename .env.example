# LinkedIn Search MCP Server - Environment Variables
# Copy this file to .env and fill in your API keys

# SerpAPI key — used to perform Google-powered LinkedIn searches
# Get your key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# (Optional) Proxycurl API key — used to fetch rich LinkedIn profile data
# Get your key at: https://nubela.co/proxycurl/
PROXYCURL_KEY=your_proxycurl_key_here
